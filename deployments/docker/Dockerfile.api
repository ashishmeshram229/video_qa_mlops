# deployments/docker/Dockerfile.api
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required by OpenCV (Updated for newer Linux versions)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt python-multipart

# Copy the source code and model weights
COPY src/ ./src/
COPY artifacts/models/ ./artifacts/models/
COPY .env .

# Expose the API port
EXPOSE 8000

# Command to run the FastAPI server
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]